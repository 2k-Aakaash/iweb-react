# Unsplash API credentials — https://unsplash.com/oauth/applications
# Copy this file to `.env` (gitignored) and fill in your values.

# "Access Key". Sent as `Authorization: Client-ID <key>`.
# WARNING: the VITE_ prefix embeds this key in the built extension, where anyone can read it.
# Unsplash's API guidelines ask that the Access Key stay confidential (via a proxy for client-side use).
# Fine for development/personal use; for a published build, route requests through a small proxy instead.
# Never prefix the secret key below with VITE_.
VITE_UNSPLASH_ACCESS_KEY=

# Application name registered with Unsplash; used as utm_source in attribution links.
VITE_UNSPLASH_APP_NAME=iweb

# "Secret Key" — only needed for OAuth user-auth flows on a server.
# NOT used by the extension and NOT exposed to the bundle (no VITE_ prefix). Keep it out of client code.
UNSPLASH_SECRET_KEY=

# DEV ONLY: overrides the 3-per-day Unsplash limit while running `npm run dev`.
# Ignored by `npm run build`. Leave empty to use the normal limit of 3.
VITE_UNSPLASH_DAILY_LIMIT=
