# Unsplash configuration — https://unsplash.com/oauth/applications
# Copy this file to `.env` (gitignored) and fill in your values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Access Key (SECRET). Server-only: used by the proxy (api/unsplash.js on Vercel, the
# Vite dev middleware for `npm run dev`). No VITE_ prefix, so it is never put in the bundle.
UNSPLASH_ACCESS_KEY=

# Secret Key — only for OAuth user-auth flows. Not used by this app.
UNSPLASH_SECRET_KEY=

# App name registered with Unsplash; used as utm_source in attribution links (not secret,
# exposed to the client via envPrefix in vite.config.js).
UNSPLASH_APP_NAME=iweb

# Where the browser sends Unsplash requests. Leave empty on the website/dev server
# (defaults to same-origin /api/unsplash). The browser-extension build MUST set it to
# your deployed proxy, e.g. https://your-app.vercel.app/api/unsplash
VITE_UNSPLASH_PROXY_URL=

# DEV ONLY: overrides the 3-per-day Unsplash limit while running `npm run dev`.
# Ignored by `npm run build`. Leave empty to use the normal limit of 3.
VITE_UNSPLASH_DAILY_LIMIT=

# ── Creator Widgets (YouTube Analytics, Instagram Analytics) ─────────────────────────
# All SERVER-ONLY (no VITE_ prefix): read by api/_creatorProxy.js on Vercel and by the
# Vite dev middleware. Never put them in a VITE_ variable. Setup: docs/CREATOR_WIDGETS.md.
# Anything left empty simply turns that feature off; the widgets say so.

# Public channel lookup (YouTube Data API v3). Restrict the key to that API.
YOUTUBE_API_KEY=

# Google OAuth client (type "Web application") for owner analytics and revenue.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app with "Instagram API with Instagram Login".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: Graph API version for graph.instagram.com (default v25.0).
INSTAGRAM_API_VERSION=

# Encrypts the connection kept in the browser (refresh / long-lived tokens). At least 32
# random characters, e.g. `openssl rand -base64 48`. Changing it disconnects every account.
CREATOR_TOKEN_KEY=

# The OAuth redirect URI registered with Google and Meta, exactly:
#   production: https://your-app.vercel.app/api/creator-callback
#   dev:        http://localhost:5173/api/creator-callback   (Google only; Meta needs https)
CREATOR_REDIRECT_URI=

# Optional: extra site origins allowed to call the creator API (comma-separated). The
# extension, localhost and the redirect URI's origin are always allowed.
CREATOR_ALLOWED_ORIGINS=

# DEV ONLY: `npm run dev` answers the creator API with sample data (no credentials needed).
# Ignored by `npm run build`.
VITE_CREATOR_MOCK=
